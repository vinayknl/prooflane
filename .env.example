# Copy values into your shell or local environment manager.
# Do not commit real API keys.

# No-LLM mode is the default and costs nothing.
PROOFLANE_AGENT_MODE=no-llm
PROOFLANE_SPRING_AI_MODEL=none

# Real OpenAI mode is opt-in.
# OPENAI_API_KEY=
# PROOFLANE_AGENT_MODE=openai
# PROOFLANE_SPRING_AI_MODEL=openai

# Cost guardrails.
PROOFLANE_MAX_EVIDENCE_CHARS=12000
PROOFLANE_MAX_LLM_CALLS=1
PROOFLANE_INPUT_TOKEN_BUDGET=4000
PROOFLANE_OUTPUT_TOKEN_BUDGET=800
